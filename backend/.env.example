# ============================================================================
# Deep Research (LangGraph 版) 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env
# 变量名与旧版 backend/.env.example 完全兼容，可以直接复用你原来的 key。
# ============================================================================

# ---------------- LLM（OpenAI 兼容端点） ----------------
# provider 只影响 base_url 的解析方式：custom / ollama / lmstudio
LLM_PROVIDER=custom
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1

# 本地模型（provider=ollama / lmstudio 时生效）
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM=qwen2.5:7b

# 生成参数
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
# 单次响应最大输出 token。thinking 模型的推理 token 也占这个预算：
# 不设上限时，长上下文任务容易出现「推理写满、JSON 正文为空」的结构化输出失败。
# 用 thinking 模型（deepseek-reasoner / deepseek-flash 等）建议设为 8192。
LLM_MAX_TOKENS=8192
# 结构化输出实现方式，按需选一个：
#   prompted_json    （推荐给 thinking 模型）纯提示词要求 JSON + 本地解析校验，兼容性最好
#   json_schema      严格模式，仅 OpenAI 系原生支持
#   json_mode        response_format=json_object，部分端点长上下文下会返回空正文
#   function_calling 强制 tool_choice，thinking 模式会直接 400
# 无论配哪个，其余方式都会作为兜底自动依次尝试。
LLM_STRUCTURED_METHOD=prompted_json

# ---------------- 搜索后端 ----------------
# duckduckgo（免 key，需 pip install ddgs）/ tavily / perplexity / searxng / advanced
SEARCH_API=duckduckgo
MAX_RESULTS_PER_QUERY=5
SEARCH_TIMEOUT=30
FETCH_FULL_PAGE=True

# TAVILY_API_KEY=tvly-xxxxx
# PERPLEXITY_API_KEY=pplx-xxxxx
# SEARXNG_URL=http://localhost:8888

# ---------------- 研究工作流 ----------------
MAX_TASKS=5
TASK_TIMEOUT=300
GRAPH_RECURSION_LIMIT=50

# ---------------- 笔记（NoteStore） ----------------
ENABLE_NOTES=True
NOTES_WORKSPACE=./notes

# ---------------- LangSmith 追踪（可选） ----------------
# 填了 key 并置 LANGSMITH_TRACING=True 才会上报；没装 langsmith 包会自动跳过
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-langgraph
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------- Web 服务 ----------------
HOST=0.0.0.0
PORT=8000
# 放行本仓库前端的开发端口（frontend/vite.config.ts 里 server.port = 5174）
# localhost 与 127.0.0.1 是不同 Origin，两个都要写。填 * 放行全部（仅本地开发用）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
